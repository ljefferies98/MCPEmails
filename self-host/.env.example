# ============================================================
# MCP Emails self-host, environment
# ============================================================
# Do not fill this in by hand. `make setup` (or `mcpe gen-secrets`) writes a
# real .env with random secrets and correctly signed PostgREST tokens. On
# Coolify, paste the same values into the application's Environment Variables.
# This file documents what each variable is for.
# ============================================================

# ── required ─────────────────────────────────────────────────────────────────

# Postgres superuser password (internal network only). Set once; it is stored
# in the database volume, so changing it later also needs ALTER ROLE.
POSTGRES_PASSWORD=

# Login password for the PostgREST `authenticator` role. The migrate service
# applies it on every start, so it can be rotated by changing it here.
AUTHENTICATOR_PASSWORD=

# HS256 secret PostgREST uses to verify JWTs. SERVICE_ROLE_JWT below is signed
# with this exact secret; regenerate them together.
JWT_SECRET=

# The service_role JWT the MCP server and CLI present to PostgREST.
SERVICE_ROLE_JWT=

# AES-256-GCM key (64 hex chars = 32 bytes) for mailbox credentials, scheduled
# sends and pending approvals at rest. NEVER change or regenerate it once an
# inbox is provisioned: everything encrypted with it becomes unreadable.
# Back it up separately from database backups.
ENCRYPTION_KEY=

# Shared secret for POST /dispatch and /triage-dispatch (scheduled sends and
# automations). Used by the bundled dispatcher service.
DISPATCH_SECRET=

# ── optional ─────────────────────────────────────────────────────────────────

# Public base URL of this server, used in links the server puts in responses.
# Behind Coolify or another HTTPS proxy, set it to that URL, e.g.
# https://mcp.example.com
APP_URL=http://localhost:8787

# Local only: host port for the loopback listener (docker-compose.override.yml).
# Bound to 127.0.0.1, never reachable from the LAN or internet. Ignored by Coolify.
MCP_PORT=8787

# Self-host does not meter usage. Leave true; the hosted billing functions the
# alternative needs are not installed.
# USAGE_ENFORCEMENT_DISABLED=true

# Escape hatch for a migration whose file changed after it was applied (e.g. a
# comment fix upstream). Set to true for one deploy only, after reading the log.
# MIGRATIONS_ALLOW_CHANGED=false

# Route SMTP submission for specific mail hosts through an HTTP CONNECT proxy,
# for hosts that refuse submission from cloud addresses
# (smtp.domeneshop.no answers "550 [ACR04] Amazon AWS IP ..."). A self-hosted
# deployment sending from its own address usually needs neither. TLS stays end
# to end, and an unreachable relay falls back to a direct dial on its own.
# Setup and hardening: docs/smtp-relay.md
# SMTP_RELAY_URL=http://user:password@relay.example.net:3128
# SMTP_RELAY_HOSTS=domeneshop.no
